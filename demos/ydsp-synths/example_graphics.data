/*
  The analog polysynth: a seven-saw supersaw stack per voice through a resonant
  state-variable filter, with a full ADSR on the amplitude and a second envelope
  on the cutoff. A held key *sustains* - this is the corpus's reference for a note
  that does not decay on its own.
*/

import "fx/Distortion.ydsp" as fx;
import "fx/MasterBus.ydsp" as bus;

declare name "Analog Saw";
declare description "A seven-saw supersaw stack through a resonant TPT filter, with amp and filter envelopes.";

let sidePairs = 3;
let unison = 2 * sidePairs + 1;

let unisonSteps = 64;

processor SawVoice {
    output stream out;

    input value float attack = 0.01 [[ name: "Attack", min: 0.001, max: 3.0, unit: "s" ]];
    input value float decay = 0.5 [[ name: "Decay", min: 0.005, max: 4.0, unit: "s" ]];
    input value float sustain = 0.65 [[ name: "Sustain", min: 0.0, max: 1.0 ]];
    input value float release = 0.5 [[ name: "Release", min: 0.02, max: 4.0, unit: "s" ]];

    input value float detune = 28.0 [[ name: "Detune", min: 0.0, max: 100.0, unit: "cents" ]];
    input value float unisonMix = 0.75 [[ name: "Unison Mix", min: 0.0, max: 1.0 ]];

    input value float cutoff = 700.0 [[ name: "Cutoff", min: 30.0, max: 12000.0 ]];
    input value float resonance = 0.55 [[ name: "Resonance", min: 0.0, max: 0.97, smoothing: 0.02 ]];
    input value float keyTrack = 0.5 [[ name: "Key Track", min: 0.0, max: 1.0 ]];

    input value float filterDecay = 0.3 [[ name: "Filter Decay", min: 0.005, max: 4.0, unit: "s" ]];
    input value float filterSustain = 0.2 [[ name: "Filter Sustain", min: 0.0, max: 1.0 ]];
    input value float filterAmount = 8.0 [[ name: "Filter Amount", min: 0.0, max: 24.0 ]];

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase[unison] = {
        0.000000, 0.618034, 0.236068, 0.854102, 0.472136, 0.090170, 0.708204
    };

    state float inc[unison];
    state int chunkCount;

    state float freq;
    state float keyFactor;
    state int stage;
    state int released;

    state float env;
    state float fenv;

    state float peak;
    state float attackRate;
    state float fAttackRate;
    state float decayCoeff;
    state float fDecayCoeff;
    state float releaseCoeff;
    state float sustainLevel;

    state float ic1;
    state float ic2;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    event noteOn (e) {
        freq = noteToFreq (e.pitch);
        keyFactor = pow (2.0, ((e.pitch - 60.0) / 12.0) * keyTrack);

        peak = e.velocity;

        attackRate = peak / (attack * sampleRate);
        fAttackRate = 1.0 / (attack * sampleRate);
        decayCoeff = 1.0 - exp (-1.0 / (decay * sampleRate));
        fDecayCoeff = 1.0 - exp (-1.0 / (filterDecay * sampleRate));
        sustainLevel = sustain * peak;

        chunkCount = 0;

        stage = 0;
        released = 0;
        active = 1;

        bendFactor = 1.0;
        vibratoPhase = 0.0;
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released = 1;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        if (chunkCount <= 0) {
            chunkCount = unisonSteps;

            vibratoPhase = vibratoPhase + 5.5 * float (unisonSteps) * samplePeriod;
            vibratoPhase = vibratoPhase - floor (vibratoPhase);

            float pitchFactor = bendFactor
                * (1.0 + 0.02888113 * modWheel * sin (vibratoPhase * 2.0 * pi));

            let dtBase = max (freq * pitchFactor * samplePeriod, 1.0e-9);

            for i in 0..unison {
                let rel = float (i - sidePairs) / float (sidePairs);
                let curve = rel * (0.6 + 0.4 * abs (rel));

                inc[i] = dtBase * pow (2.0, detune * curve / 1200.0);
            }
        }

        chunkCount = chunkCount - 1;

        float total = 0.0;
        float centre = 0.0;

        for i in 0..unison {
            phase[i] = phase[i] + inc[i];
            phase[i] = phase[i] - floor (phase[i]);

            let t = phase[i];
            let dt = inc[i];

            let a = t / dt;
            let b = (t - 1.0) / dt;

            let residual = select (t < dt, a + a - a * a - 1.0,
                           select (t > 1.0 - dt, b * b + b + b + 1.0, 0.0));

            let s = 2.0 * t - 1.0 - residual;

            total = total + s;
            centre = select (i == sidePairs, s, centre);
        }

        float side = smooth (unisonMix, 0.02);
        float norm = 1.0 / sqrt (1.0 + float (unison - 1) * side * side);
        float saw = (centre + (total - centre) * side) * norm;

        if (released > 0) {
            env = env * releaseCoeff;
            fenv = fenv * releaseCoeff;
        } else if (stage == 0) {
            env = env + attackRate;
            fenv = fenv + fAttackRate;
            if (env >= peak) { env = peak; stage = 1; }
            if (fenv > 1.0) { fenv = 1.0; }
        } else {
            env = env + (sustainLevel - env) * decayCoeff;
            fenv = fenv + (filterSustain - fenv) * fDecayCoeff;
        }

        float g = clamp (smooth (tan (pi * cutoff * samplePeriod), 0.02)
                             * keyFactor * (1.0 + filterAmount * fenv),
                         0.0005,
                         8.0);

        float k = 2.0 - 2.0 * resonance;
        float a1 = 1.0 / (1.0 + g * (g + k));
        float a2 = g * a1;
        float a3 = g * a2;
        float v3 = saw - ic2;
        float v1 = a1 * ic1 + a2 * v3;
        float v2 = ic2 + a2 * ic1 + a3 * v3;

        ic1 = 2.0 * v1 - ic1;
        ic2 = 2.0 * v2 - ic2;

        active = select (env < 0.000001, 0, 1);

        out = v2 * env * 1.4;
    }
}

graph AnalogSaw {
    input event midi;
    output stream out;

    node voices = SawVoice[8] [[ mode: poly, stealing: oldest ]];
    node distortion = fx.Distortion (drive = 1.0, tone = 0.45, mix = 0.45);

    node master = bus.MasterBus (threshold = -24.0, reverbMix = 0.18);

    connection {
        voices.out -> distortion.in;
        distortion.out -> master.in;
        master.out -> out;
    }
}
/*
  An envelope-following auto-wah over a plucked string, and the patch that `/N`
  exists for.

  The voice is a Karplus-Strong string: a noise burst written into a ring buffer
  one period long, read out, lowpassed and written back, so the excitation
  circulates and loses its upper partials on every lap. It is here rather than an
  oscillator for two reasons. It is the corpus's only physical-modelling voice -
  no phase accumulator anywhere in it - and it produces a *real transient*, which
  is what makes the delay compensation below audible instead of theoretical.
*/

declare name "Control Rate Wah";
declare description "Karplus-Strong plucked string into an auto-wah whose detector runs at 1/8 rate.";

let ringSize = 2048;

processor StringVoice {
    output stream out;

    input value float damping = 0.35 [[ name: "Damping", min: 0.0, max: 0.9, smoothing: 0.02 ]];
    input value float decay = 1.6 [[ name: "Decay", min: 0.1, max: 8.0, unit: "s" ]];
    input value float mute = 0.2 [[ name: "Mute Time", min: 0.02, max: 1.0, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float buf[ringSize];
    state int writePos;
    state float freq;
    state float loopGain;
    state float lp;

    state float amp;
    state float ampCoeff;

    state float loudness;

    state int active [[ role: voiceActivity ]];

    state int rng;

    event noteOn (e) {
        freq = 440.0 * pow (2.0, (e.pitch - 69.0) / 12.0);

        int n = int (sampleRate / freq);
        if (n < 2) n = 2;
        if (n > 2040) n = 2040;

        loopGain = pow (0.001, float (n) / (decay * sampleRate));
        if (loopGain > 0.9995) { loopGain = 0.9995; }

        writePos = 0;
        lp       = 0.0;
        amp      = 1.0;
        ampCoeff = 1.0;
        loudness = 1.0;
        active   = 1;

        bendFactor = 1.0;
        vibratoPhase = 0.0;

        rng = rng ^ (int (e.pitch) * 1103515245);

        let strength = e.velocity;

        for i in 0..ringSize {
            rng = rng * 1664525 + 1013904223;
            buf[i] = float (rng >> 8) * 1.1920929e-7 * strength;
        }
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    event noteOff (e) {
        ampCoeff = pow (0.001, 1.0 / (mute * sampleRate));
    }

    process {
        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float loopLength = clamp (sampleRate / max (freq * pitchFactor, 1.0), 2.0, 2040.0);

        float readPos = float (writePos) - loopLength;
        if (readPos < 0.0) { readPos = readPos + float (ringSize); }

        int i0 = int (readPos);
        int i1 = i0 + 1;
        if (i1 >= ringSize) { i1 = 0; }

        float sample = lerp (buf[i0], buf[i1], readPos - float (i0));

        lp = lp + (1.0 - damping) * (sample - lp);
        buf[writePos] = lp * loopGain;

        writePos = writePos + 1;
        if (writePos >= ringSize) { writePos = 0; }

        amp = amp * ampCoeff;

        float y = sample * amp * 0.6;

        loudness = max (abs (y), loudness * 0.9995);
        active = select (loudness < 0.000001, 0, 1);

        out = y;
    }
}

processor Follower {
    input stream in;
    output stream out;

    input value float attack = 0.004 [[ name: "Attack", min: 0.001, max: 0.05, unit: "s" ]];
    input value float release = 0.15 [[ name: "Release", min: 0.02, max: 1.0, unit: "s" ]];

    state float env;

    process {
        float rectified = abs (in);

        float coeff = select (rectified > env,
                              exp (-1.0 / (attack * sampleRate)),
                              exp (-1.0 / (release * sampleRate)));

        env = rectified + coeff * (env - rectified);

        out = env;
    }
}

processor Wah {
    input stream in;
    input stream cv;
    output stream out;

    input value float baseCutoff = 300.0 [[ name: "Base Cutoff", min: 80.0, max: 2000.0 ]];
    input value float sweep = 4000.0 [[ name: "Sweep", min: 0.0, max: 8000.0 ]];
    input value float resonance = 0.7 [[ name: "Resonance", min: 0.0, max: 0.95, smoothing: 0.02 ]];

    state float z1;
    state float z2;

    process {
        float cutoff = clamp (baseCutoff + sweep * cv, 40.0, 0.45 * sampleRate);

        float k = 1.0 - exp (-6.283185307 * cutoff / sampleRate);

        float driven = in + resonance * z2;
        z1 = z1 + k * (driven - z1);
        z2 = z2 + k * (z1 - z2);

        out = z2 * 1.5;
    }
}

graph ControlRateWah {
    input event midi;
    output stream out;

    node voices = StringVoice[4];
    node follower = Follower / 8;
    node wah = Wah;

    connection {
        voices.out -> follower.in;
        voices.out -> wah.in;

        follower.out -> wah.cv;

        wah.out -> out;
    }
}
/*
  Parallel saturation over a drum voice, and the patch that delay compensation
  exists for.

  One key of the keyboard per drum C-4 (kick), C#4 (snare), D-4 (hat), D#4 (tom).
*/

declare name "Digital Drums";
declare description "A digital drum voice split into clean and oversampled-clipped paths, with the 48-sample skew compensated.";

processor DrumVoice {
    output stream out;

    input value float kit = 1.0 [[ name: "Kit", min: 0.0, max: 3.0,
                                   values: { "Tight", "Room", "Deep", "Lo-Fi" } ]];

    input value float tune = 1.0 [[ name: "Tune", min: 0.5, max: 2.0 ]];
    input value float decayScale = 1.0 [[ name: "Decay", min: 0.25, max: 3.0 ]];
    input value float tone = 0.5 [[ name: "Noise/Tone", min: 0.0, max: 1.0, smoothing: 0.02 ]];

    input event noteOn;
    input event programChange;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase;
    state float baseFreq;

    state float toneMix;
    state float sweepAmount;
    state float hpAmount;

    state float env;
    state float ampCoeff;
    state float pitchEnv;
    state float pitchCoeff;

    state float nz;
    state int rng;

    state int progKit;
    state int progSet;

    state int active [[ role: voiceActivity ]];

    event noteOn (e) {
        int note = int (e.pitch);

        float ampSeconds = 0.2;
        float sweepSeconds = 0.02;

        if (note == 49) {
            // Snare: a tuned shell tone under a broadband crack. The noise is
            // most of it, which is why `toneMix` is low.
            baseFreq = 185.0;
            toneMix = 0.35;
            sweepAmount = 0.6;
            hpAmount = 0.45;
            ampSeconds = 0.19;
            sweepSeconds = 0.02;
        } else if (note == 50) {
            // Hat: all noise, brightly highpassed, and very short.
            baseFreq = 320.0;
            toneMix = 0.0;
            sweepAmount = 0.0;
            hpAmount = 1.0;
            ampSeconds = 0.055;
            sweepSeconds = 0.01;
        } else if (note == 51) {
            // Tom: a sine with a gentler sweep and a longer body than the kick.
            baseFreq = 120.0;
            toneMix = 0.85;
            sweepAmount = 1.4;
            hpAmount = 0.15;
            ampSeconds = 0.34;
            sweepSeconds = 0.06;
        } else /* note == 48 */ {
            // Kick: a deep sine with a fast, deep downward pitch sweep and no
            // noise at all. The sweep is the beater; the body is the tail.
            baseFreq = 52.0;
            toneMix = 1.0;
            sweepAmount = 3.2;
            hpAmount = 0.0;
            ampSeconds = 0.42;
            sweepSeconds = 0.045;
        }

        int chosen = int (kit);
        if (progSet != 0) { chosen = progKit; }

        float kitDecay = 1.0;
        float kitPitch = 1.0;

        if (chosen == 0) {
            kitDecay = 0.6;
            kitPitch = 1.15;
        } else if (chosen == 2) {
            kitDecay = 2.2;
            kitPitch = 0.72;
        } else if (chosen == 3) {
            kitDecay = 1.4;
            kitPitch = 0.9;
            hpAmount = hpAmount * 0.5;
            toneMix = toneMix * 0.7;
        }

        baseFreq = baseFreq * kitPitch * tune;

        ampCoeff = pow (0.001, 1.0 / (ampSeconds * kitDecay * decayScale * sampleRate));
        pitchCoeff = pow (0.001, 1.0 / (sweepSeconds * sampleRate));

        phase = 0.0;
        env = e.velocity;
        pitchEnv = 1.0;
        active = 1;

        rng = rng ^ (int (e.pitch) * 1103515245);

        bendFactor = 1.0;
        vibratoPhase = 0.0;
    }

    event programChange (e) {
        progKit = e.program % 4;
        progSet = 1;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        pitchEnv = pitchEnv * pitchCoeff;
        env = env * ampCoeff;

        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float freq = baseFreq * (1.0 + sweepAmount * pitchEnv) * pitchFactor;

        phase = phase + freq * samplePeriod;
        if (phase >= 1.0) { phase = phase - 1.0; }

        float osc = sin (phase * 2.0 * pi);

        rng = rng * 1664525 + 1013904223;
        float noise = float (rng >> 8) * 1.1920929e-7;

        float nk = 1.0 - exp (-2.0 * pi * 1200.0 * samplePeriod);
        nz = nz + nk * (noise - nz);
        float shaped = lerp (nz, noise - nz, hpAmount);

        float balance = clamp (toneMix + 2.0 * (tone - 0.5), 0.0, 1.0);

        active = select (env < 0.000001, 0, 1);

        out = (osc * balance + shaped * (1.0 - balance)) * env;
    }
}

processor CleanPath {
    input stream in;
    output stream out;

    input value float level = 0.5 [[ name: "Clean Level", min: 0.0, max: 2.0, smoothing: 0.02 ]];

    process { out = in * level; }
}

processor HardClip {
    input stream in;
    output stream out;

    input value float drive = 4.0 [[ name: "Drive", min: 1.0, max: 20.0, smoothing: 0.02 ]];
    input value float level = 0.5 [[ name: "Drive Level", min: 0.0, max: 2.0, smoothing: 0.02 ]];

    process { out = clamp (in * drive, -1.0, 1.0) * level; }
}

processor Lookahead [[ latency: 32 ]] {
    input stream in;
    output stream out;

    input value float ceiling = 0.8 [[ name: "Ceiling", min: 0.1, max: 1.0, smoothing: 0.02 ]];

    output value float reduction;

    state float env;

    process {
        float peak = abs (in);
        env = select (peak > env, peak, env * 0.9995);

        float safeEnv = max (env, 0.000001);
        float gain = select (env > ceiling, ceiling / safeEnv, 1.0);

        reduction = 1.0 - gain;

        out = (in @ 32) * gain;
    }
}

graph ParallelDrive {
    input event midi;
    output stream out;

    input value float kit = 1.0 [[ name: "Kit", min: 0.0, max: 3.0,
                                   values: { "Tight", "Room", "Deep", "Lo-Fi" } ]];

    output value float reduction;

    node voices = DrumVoice[8] [[ mode: poly, stealing: oldest ]];
    node clean = CleanPath;
    node drive = HardClip * 4;
    node limiter = Lookahead;

    connection {
        voices.out -> clean.in;
        voices.out -> drive.in;

        drive.out -> limiter.in;

        clean.out -> out;
        limiter.out -> out;

        kit -> voices.kit;

        limiter.reduction -> reduction;
    }
}
/*
  A 16-voice additive electric piano.

  Each voice runs a bank of 32 complex-rotation oscillators (a unit-modulus
  complex multiply per partial per sample, which is cheaper and driftless
  compared to a phase accumulator plus sin()). The partial amplitudes are held
  in a parallel array and interpolated linearly between recomputed exponential
  decay targets every `rampSteps` samples, so the per-sample cost of the
  envelope is one add per partial.

  The oscillator bank is stored as four parallel float arrays (real/imaginary
  for the running phasor and its per-sample multiplier) rather than as a struct
  of complex values: the harmonic loop then walks unit-stride over each array,
  which is the shape a vectoriser can widen.
*/

declare name "Electric Piano";
declare description "16-voice additive electric piano with a 32-partial oscillator bank and stereo tremolo.";

let harmonics = 32;
let rampSteps = 64;

//==============================================================================

processor EPVoice {
    output stream out;

    input value float brightness = 30.0;
    input value float velocitySensitivity = 60.0;
    input value float decayRate = 50.0;
    input value float harmonicDecayRate = 50.0;
    input value float keyScaling = 50.0;
    input value float releaseRate = 40.0;

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float velAt100[harmonics] = {
        0.150869, 0.385766, 0.166484, 0.087412, 0.114967, 0.062138, 0.038751, 0.048902,
        0.031164, 0.019870, 0.024413, 0.015082, 0.010337, 0.012061, 0.007988, 0.005541,
        0.006272, 0.004319, 0.003043, 0.003371, 0.002397, 0.001723, 0.001858, 0.001361,
        0.000994, 0.001048, 0.000784, 0.000582, 0.000602, 0.000459, 0.000345, 0.000352
    };

    state float velAt0[harmonics] = {
        0.020000, 0.050000, 0.012000, 0.004500, 0.003000, 0.001200, 0.000600, 0.000350,
        0.000200, 0.000120, 0.000075, 0.000048, 0.000030, 0.000020, 0.000013, 0.000009
    };

    state float oscR[harmonics];
    state float oscI[harmonics];
    state float mulR[harmonics];
    state float mulI[harmonics];

    state float amp[harmonics];
    state float inc[harmonics];
    state float dec[harmonics];
    state float rel[harmonics];

    state int released;
    state int rampCount;

    state float baseOmega;
    state float lastPitchFactor;

    state int active [[ role: voiceActivity ]];

    event noteOn (e) {
        let freq = 440.0 * pow (2.0, (e.pitch - 69.0) / 12.0);
        let nyquist = sampleRate * 0.5;
        let omega = 2.0 * pi * freq * samplePeriod;

        baseOmega = omega;

        let keyFactor = pow (0.5, ((e.pitch - 60.0) / 24.0) * (keyScaling * 0.01));
        let decaySeconds = (0.15 + decayRate * 0.14) * keyFactor;
        let releaseSeconds = 0.02 + releaseRate * 0.008;
        let velocity = clamp (e.velocity, 0.0, 1.0);
        let sensitivity = clamp (velocitySensitivity * 0.01, 0.0, 1.0);
        let blend = clamp (1.0 - sensitivity + velocity * sensitivity, 0.0, 1.0);
        let tilt = brightness * 0.01 - 0.5;

        released = 0;
        rampCount = 0;
        active = 1;

        bendFactor = 1.0;
        vibratoPhase = 0.0;
        lastPitchFactor = 1.0;

        for i in 0..harmonics {
            let partial = float (i + 1);
            let w = omega * partial;
            let audible = select (freq * partial < nyquist, 1.0, 0.0);

            mulR[i] = cos (w);
            mulI[i] = sin (w);
            oscR[i] = 1.0;
            oscI[i] = 0.0;

            amp[i] = lerp (velAt0[i], velAt100[i], blend) * pow (partial, tilt) * velocity * audible;
            inc[i] = 0.0;

            let harmonicFactor = 1.0 + (partial - 1.0) * (harmonicDecayRate * 0.05);
            dec[i] = pow (0.001, (rampSteps * samplePeriod) / (decaySeconds / harmonicFactor));
            rel[i] = pow (0.001, (rampSteps * samplePeriod) / releaseSeconds);
        }
    }

    event noteOff (e) {
        released = 1;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        float peak = 0.0;

        if (rampCount <= 0) {
            rampCount = rampSteps;

            vibratoPhase = vibratoPhase + 5.5 * float (rampSteps) * samplePeriod;
            vibratoPhase = vibratoPhase - floor (vibratoPhase);

            float pitchFactor = bendFactor
                * (1.0 + 0.02888113 * modWheel * sin (vibratoPhase * 2.0 * pi));


            if (pitchFactor != lastPitchFactor) {
                lastPitchFactor = pitchFactor;

                for i in 0..harmonics {
                    let w = baseOmega * float (i + 1) * pitchFactor;
                    mulR[i] = cos (w);
                    mulI[i] = sin (w);
                }
            }

            for i in 0..harmonics {
                let target = amp[i] * select (released > 0, rel[i], dec[i]);
                inc[i] = (target - amp[i]) / rampSteps;
                peak = max (peak, abs (amp[i]));
            }

            active = select (peak < 0.000001, 0, 1);
        }

        rampCount = rampCount - 1;

        float sum = 0.0;

        for i in 0..harmonics {
            let rotated = oscR[i] * mulR[i] - oscI[i] * mulI[i];
            oscI[i] = oscR[i] * mulI[i] + oscI[i] * mulR[i];
            oscR[i] = rotated;
            amp[i] = amp[i] + inc[i];
            sum = sum + oscI[i] * amp[i];
        }

        out = sum;
    }
}

//==============================================================================

processor Tremolo {
    input stream in;
    output stream outL, outR;

    input value float vibratoRate = 4.0;
    input value float vibratoDepth = 0.5 [[ smoothing: 0.02 ]];

    state float phase;
    state float direction = 1.0;

    process {
        let step = 4.0 * vibratoRate * samplePeriod;

        phase = phase + step * direction;

        if (phase >= 1.0) { phase = 1.0; direction = -1.0; }
        if (phase <= -1.0) { phase = -1.0; direction = 1.0; }

        let depth = clamp (vibratoDepth, 0.0, 1.0) * 0.5;

        outL = in * (1.0 - depth + depth * phase);
        outR = in * (1.0 - depth - depth * phase);
    }
}

//==============================================================================

graph ElectricPiano {
    input event midi;

    output stream outL, outR;

    input value float brightness = 30.0 [[ name: "Brightness", min: 0.0, max: 100.0 ]];
    input value float velocitySensitivity = 60.0 [[ name: "Velocity Sensitivity", min: 0.0, max: 100.0 ]];
    input value float decayRate = 50.0 [[ name: "Decay", min: 0.0, max: 100.0 ]];
    input value float harmonicDecayRate = 50.0 [[ name: "Harmonic Decay", min: 0.0, max: 100.0 ]];
    input value float keyScaling = 50.0 [[ name: "Key Scaling", min: 0.0, max: 100.0 ]];
    input value float releaseRate = 40.0 [[ name: "Release", min: 0.0, max: 100.0 ]];
    input value float vibratoRate [[ name: "Vibrato Rate", min: 0.5, max: 12.0, init: 4 ]];
    input value float vibratoDepth = 0.5 [[ name: "Vibrato Depth", min: 0.0, max: 1.0 ]];

    node voices = EPVoice[16] [[ mode: poly, stealing: oldest ]];
    node trem = Tremolo;

    connection {
        voices.out -> trem.in;

        trem.outL -> outL;
        trem.outR -> outR;

        brightness -> voices.brightness;
        velocitySensitivity -> voices.velocitySensitivity;
        decayRate -> voices.decayRate;
        harmonicDecayRate -> voices.harmonicDecayRate;
        keyScaling -> voices.keyScaling;
        releaseRate -> voices.releaseRate;

        vibratoRate -> trem.vibratoRate;
        vibratoDepth -> trem.vibratoDepth;
    }
}
/*
  A four-operator FM bell, and the demo's `pitchBend` example.

  Four sine operators, an inharmonic ratio each, and a selectable routing between
  them. Operator 4 modulates *itself* - the classic way to get a noisy, metallic
  strike out of a pure sine bank - through a `state` slot holding its previous
  output rather than through the `'` primitive, because the same value is also
  read by three of the four algorithms and one slot is clearer than four reads.
*/

import "fx/Reverb.ydsp" as fx;

declare name "FM Bell";
declare description "Four-operator FM bell with self-feedback, four algorithms and pitch-bend tracking.";

processor FMBellVoice {
    output stream out;

    input value float algorithm = 0.0 [[ name: "Algorithm", min: 0.0, max: 3.0,
                                         values: { "Stack", "Two Pairs", "One To Three", "Additive" } ]];

    input value float index = 3.5 [[ name: "Mod Index", min: 0.0, max: 12.0, smoothing: 0.02 ]];
    input value float feedback = 0.4 [[ name: "Op 4 Feedback", min: 0.0, max: 2.0, smoothing: 0.02 ]];

    input value float ratio2 = 2.0 [[ name: "Ratio 2", min: 0.25, max: 12.0 ]];
    input value float ratio3 = 3.51 [[ name: "Ratio 3", min: 0.25, max: 12.0 ]];
    input value float ratio4 = 7.02 [[ name: "Ratio 4", min: 0.25, max: 12.0 ]];

    input value float decay = 1.1 [[ name: "Strike Decay", min: 0.05, max: 6.0, unit: "s" ]];
    input value float tail = 4.5 [[ name: "Ring Tail", min: 0.2, max: 12.0, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float p1;
    state float p2;
    state float p3;
    state float p4;

    state float baseFreq;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float fb;

    state float env1;
    state float env2;
    state float coeff1;
    state float coeff2;

    state int active [[ role: voiceActivity ]];

    event noteOn (e) {
        baseFreq = 440.0 * pow (2.0, (e.pitch - 69.0) / 12.0);

        bendFactor = 1.0;
        vibratoPhase = 0.0;

        env1 = e.velocity;
        env2 = e.velocity;

        coeff1 = pow (0.001, 1.0 / (decay * sampleRate));
        coeff2 = pow (0.001, 1.0 / (tail * sampleRate));

        active = 1;
    }

    event noteOff (e) {
        coeff1 = pow (0.001, 1.0 / (0.12 * sampleRate));
        coeff2 = pow (0.001, 1.0 / (0.5 * sampleRate));
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        let twoPi = 2.0 * pi;

        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
                          * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float dt = baseFreq * pitchFactor * samplePeriod;

        p1 = p1 + dt;
        p1 = p1 - floor (p1);

        p2 = p2 + dt * ratio2;
        p2 = p2 - floor (p2);

        p3 = p3 + dt * ratio3;
        p3 = p3 - floor (p3);

        p4 = p4 + dt * ratio4;
        p4 = p4 - floor (p4);

        env1 = env1 * coeff1;
        env2 = env2 * coeff2;

        float op4 = sin (p4 * twoPi + feedback * fb);
        fb = op4;

        float op3 = sin (p3 * twoPi + index * op4);

        float stack = sin (p1 * twoPi + index * sin (p2 * twoPi + index * op3));

        float pairs = (sin (p1 * twoPi + index * sin (p2 * twoPi)) + op3) * 0.5;

        float fan = (sin (p1 * twoPi + index * op4)
                   + sin (p2 * twoPi + index * op4)
                   + op3) * 0.33333333;

        float additive = (sin (p1 * twoPi) + sin (p2 * twoPi) + sin (p3 * twoPi) + op4) * 0.25;

        float voice = select (algorithm < 0.5, stack,
                      select (algorithm < 1.5, pairs,
                      select (algorithm < 2.5, fan, additive)));

        float amp = env1 * 0.7 + env2 * 0.3;

        active = select (amp < 0.000001, 0, 1);

        out = voice * amp * 0.6;
    }
}

graph FMBell {
    input event midi;
    output stream out;

    input value float space = 0.45 [[ name: "Space", min: 0.0, max: 1.0 ]];

    node voices = FMBellVoice[6] [[ mode: poly, stealing: oldest ]];
    node reverb = fx.Reverb (damping = 0.45);

    connection {
        voices.out -> reverb.in;
        reverb.out -> out;

        space -> reverb.mix;
        space -> reverb.roomSize;
    }
}
/*
  A formant voice, and parallel processing expressed in the graph rather than
  inside a processor.

  One glottal source fans out into three independent resonators - F1, F2 and F3 -
  and all three are summed straight back into `out`. That is the classic source /
  filter model of a sung vowel: a buzzy pulse train for the vocal folds, and a
  small bank of resonant peaks for the shape of the mouth. Move the peaks and the
  vowel changes; the source never does.
*/

declare name "Formants";
declare description "A sung-vowel voice: one glottal source fanned out to three formant resonators, summed back.";

let vowels = 5;
let formants = 3;

let vowelTable = vowels * formants;

processor GlottalVoice {
    output stream out;

    input value float width = 0.12 [[ name: "Glottal Width", min: 0.02, max: 0.5, smoothing: 0.02 ]];
    input value float rolloff = 0.6 [[ name: "Source Rolloff", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float attack = 0.03 [[ name: "Attack", min: 0.002, max: 1.0, unit: "s" ]];
    input value float release = 0.25 [[ name: "Release", min: 0.02, max: 3.0, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase;
    state float freq;
    state float z1;

    state float env;
    state float level;
    state float attackCoeff;
    state float releaseCoeff;
    state int released;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    func polyBlep (float t, float dt) : float {
        float r = 0.0;
        if (t < dt) {
            t = t / dt;
            r = t + t - t * t - 1.0;
        } else if (t > 1.0 - dt) {
            t = (t - 1.0) / dt;
            r = t * t + t + t + 1.0;
        }
        return r;
    }

    event noteOn (e) {
        freq         = noteToFreq (e.pitch);
        level        = e.velocity;
        attackCoeff  = 1.0 - exp (-1.0 / (attack * sampleRate));
        released     = 0;
        active       = 1;
        bendFactor   = 1.0;
        vibratoPhase = 0.0;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released     = 1;
    }

    process {
        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float dt = freq * pitchFactor * samplePeriod;

        phase = phase + dt;
        if (phase >= 1.0) { phase = phase - 1.0; }

        float falling = phase < width ? phase - width + 1.0 : phase - width;
        float pulse = (phase < width ? 1.0 : -1.0)
                    + polyBlep (phase, dt)
                    - polyBlep (falling, dt);

        float k = 1.0 - exp (-2.0 * pi * 2500.0 * samplePeriod);
        z1 = z1 + k * (pulse - z1);

        if (released > 0) {
            env = env * releaseCoeff;
        } else {
            env = env + (level - env) * attackCoeff;
        }

        active = select (env < 0.000001, 0, 1);

        out = (pulse + rolloff * (z1 - pulse)) * env * 0.5;
    }
}

processor Formant {
    input stream in;
    output stream out;

    input value float vowel = 0.0 [[ name: "Vowel", min: 0.0, max: 4.0,
                                     values: { "A", "E", "I", "O", "U" } ]];

    input value float tilt = 1.0 [[ name: "Formant Tilt", min: 0.2, max: 2.0 ]];
    input value int which = 0;

    state float centres[vowelTable] = {
        730.0, 1090.0, 2440.0,
        530.0, 1840.0, 2480.0,
        270.0, 2290.0, 3010.0,
        570.0,  840.0, 2410.0,
        300.0,  870.0, 2240.0
    };

    state float bandwidths[formants] = { 70.0, 110.0, 160.0 };

    state float levels[formants] = { 1.0, 0.45, 0.22 };

    state float y1;
    state float y2;

    process {
        int row = int (vowel);
        if (row < 0) { row = 0; }
        if (row > vowels - 1) { row = vowels - 1; }

        float r = exp (-pi * bandwidths[which] * samplePeriod);
        float theta = 2.0 * pi * centres[row * formants + which] * samplePeriod;

        float cosTheta = smooth (cos (theta), 0.05);
        float a0 = smooth ((1.0 - r * r) * sin (theta), 0.05);

        float y = a0 * in + 2.0 * r * cosTheta * y1 - r * r * y2;

        y2 = y1;
        y1 = y;

        out = y * smooth (levels[which] * pow (tilt, float (which)), 0.02);
    }
}

//==============================================================================

graph ParallelRack {
    input event midi;
    output stream out;

    input value float vowel = 0.0 [[ name: "Vowel", min: 0.0, max: 4.0,
                                     values: { "A", "E", "I", "O", "U" } ]];

    input value float tilt = 1.0 [[ name: "Formant Tilt", min: 0.2, max: 2.0 ]];

    node voices = GlottalVoice[6];

    node f1 = Formant (which = 0);
    node f2 = Formant (which = 1);
    node f3 = Formant (which = 2);

    connection {
        voices.out -> f1.in;
        voices.out -> f2.in;
        voices.out -> f3.in;

        f1.out -> out;
        f2.out -> out;
        f3.out -> out;

        vowel -> f1.vowel;
        vowel -> f2.vowel;
        vowel -> f3.vowel;

        tilt -> f1.tilt;
        tilt -> f2.tilt;
        tilt -> f3.tilt;
    }
}
/*
  A stereo Haas widener built entirely out of graph wiring, over an inharmonic
  shimmer pad.

  One mono tone chain feeds *both* graph outputs, with a short inline delay on
  the right-hand edge. Below about 30 ms the ear reads that delay as direction
  rather than as an echo, so the note appears wide without any extra DSP: the
  whole stereo effect is two edges and a `[N]`.
*/

declare name "Haas Widener";
declare description "Inharmonic shimmer pad fanned out to both outputs, with a short inline delay on the right.";

let partials = 6;
let chunkSteps = 64;

processor ShimmerVoice {
    output stream out;

    input value float attack = 0.8 [[ name: "Attack", min: 0.01, max: 6.0, unit: "s" ]];
    input value float release = 2.5 [[ name: "Release", min: 0.1, max: 10.0, unit: "s" ]];
    input value float spread = 1.4 [[ name: "Inharmonicity", min: 0.0, max: 2.0 ]];
    input value float shimmer = 0.6 [[ name: "Shimmer", min: 0.0, max: 1.0 ]];

    input event noteOn;
    input event noteOff;
    input event slide;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float ratios[partials] = { 1.0, 2.756, 5.404, 8.933, 13.345, 18.64 };

    state float freq;
    state float phase[partials];
    state float inc[partials];
    state float partialRatio[partials];
    state float weight[partials];
    state float gain[partials];
    state float lfoPhase[partials];
    state float lfoInc[partials];

    state float env;
    state float level;
    state float attackRate;
    state float releaseCoeff;
    state int released;
    state int chunkCount;

    state float brightness = 0.5;

    state int active [[ role: voiceActivity ]];

    event noteOn (e) {
        freq = 440.0 * pow (2.0, (e.pitch - 69.0) / 12.0);

        level      = e.velocity;
        attackRate = e.velocity / (attack * sampleRate);
        released   = 0;
        chunkCount = 0;
        active     = 1;

        brightness = 0.5;

        bendFactor = 1.0;
        vibratoPhase = 0.0;

        for i in 0..partials {
            let partial = lerp (float (i + 1), ratios[i], clamp (spread * 0.5, 0.0, 1.0));

            phase[i] = 0.0;
            partialRatio[i] = partial;
            inc[i] = freq * partial * samplePeriod;

            weight[i] = 1.0 / (1.0 + 1.4 * float (i));
            gain[i] = 0.0;

            lfoPhase[i] = float (i) * 0.17;
            lfoInc[i] = (0.07 + 0.041 * float (i)) * float (chunkSteps) * samplePeriod;
        }
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released     = 1;
    }

    event slide (e) {
        brightness = e.slide;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        if (released > 0) {
            env = env * releaseCoeff;
        } else {
            env = env + attackRate;
            if (env >= level) { env = level; }
        }

        if (chunkCount <= 0) {
            chunkCount = chunkSteps;

            vibratoPhase = vibratoPhase + 5.5 * float (chunkSteps) * samplePeriod;
            vibratoPhase = vibratoPhase - floor (vibratoPhase);

            float pitchFactor = bendFactor
                * (1.0 + 0.02888113 * modWheel * sin (vibratoPhase * 2.0 * pi));

            let base = freq * pitchFactor * samplePeriod;

            let tilt = 0.55 + 0.9 * brightness;

            float loudest = 0.0;

            for i in 0..partials {
                lfoPhase[i] = lfoPhase[i] + lfoInc[i];
                lfoPhase[i] = lfoPhase[i] - floor (lfoPhase[i]);

                let wobble = 1.0 - shimmer + shimmer * (0.5 + 0.5 * sin (lfoPhase[i] * 2.0 * pi));

                inc[i] = base * partialRatio[i];

                let audible = select (inc[i] < 0.5, 1.0, 0.0);

                gain[i] = weight[i] * wobble * pow (tilt, float (i)) * audible;
                loudest = max (loudest, gain[i]);
            }

            active = select (loudest * env < 0.000001, 0, 1);
        }

        chunkCount = chunkCount - 1;

        float sum = 0.0;

        for i in 0..partials {
            phase[i] = phase[i] + inc[i];
            phase[i] = phase[i] - floor (phase[i]);
            sum = sum + sin (phase[i] * 2.0 * pi) * gain[i];
        }

        out = sum * env * 0.8;
    }
}

processor Tone {
    input stream in;
    output stream out;

    input value float cutoff = 3000.0 [[ name: "Cutoff", min: 200.0, max: 12000.0 ]];
    input value float drive = 1.5 [[ name: "Drive", min: 1.0, max: 8.0, smoothing: 0.02 ]];

    state float z1;

    process {
        float k = smooth (1.0 - exp (-6.283185307 * cutoff / sampleRate), 0.02);
        z1 = z1 + k * (in - z1);

        out = tanh (z1 * drive) * 0.7;
    }
}

graph HaasWidener {
    input event midi;

    output stream left;
    output stream right;

    node voices = ShimmerVoice[6] [[ mode: poly, stealing: oldest ]];
    node tone = Tone;

    connection {
        voices.out -> tone.in;

        tone.out -> left;
        tone.out -> [576] -> right;
    }
}
/*
  The corpus's minimal reference patch: one sine per voice, no filter, and an
  attack/release envelope that actually *sustains* - a held key holds its level
  instead of decaying away.
*/

import "fx/Delay.ydsp" as fx;

declare name "Poly Sine";
declare description "8-voice sine with a sustaining AR envelope and an aftertouch swell.";

processor SineVoice {
    output stream out;

    input value float attack = 0.02 [[ name: "Attack", min: 0.001, max: 2.0, unit: "s" ]];
    input value float release = 0.45 [[ name: "Release", min: 0.02, max: 4.0, unit: "s" ]];
    input value float swell = 1.0 [[ name: "Pressure Swell", min: 0.0, max: 3.0 ]];

    input event noteOn;
    input event noteOff;
    input event pressure;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase;
    state float freq;

    state float env;
    state float level;
    state float attackCoeff;
    state float releaseCoeff;
    state int released;

    state float press;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    event noteOn (e) {
        freq         = noteToFreq (e.pitch);
        level        = e.velocity;
        attackCoeff  = 1.0 - exp (-1.0 / (attack * sampleRate));
        released     = 0;
        active       = 1;
        press        = 0.0;
        bendFactor   = 1.0;
        vibratoPhase = 0.0;
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released     = 1;
    }

    event pressure (e) {
        press = e.pressure;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        phase = phase + freq * pitchFactor * samplePeriod;
        if (phase >= 1.0) { phase = phase - 1.0; }

        if (released > 0) {
            env = env * releaseCoeff;
        } else {
            env = env + (level - env) * attackCoeff;
        }

        float gain = env * (1.0 + swell * smooth (press, 0.03));

        active = select (gain < 0.000001, 0, 1);

        out = sin (phase * 2.0 * pi) * gain * 0.4;
    }
}

graph PolySine {
    input event midi;
    output stream out;

    node voices = SineVoice[8];
    node delay = fx.Delay (time = 0.35, feedback = 0.4, damping = 0.5, mix = 0.28);

    process = voices : delay : out;
}
/*
  A monophonic bass: a band-limited pulse with a square sub-oscillator an octave
  below it, through a four-pole ladder filter swept by its own envelope.

  This is the demo's monophonic patch: `[[ mode: mono ]]` gives the node a
  single voice driven by a held-note stack, so playing a new key while another
  is still down continues the same voice rather than starting a second one. The
  runtime flags such a note-on as a legato continuation (`e.isLegato`), which
  this patch uses to skip the re-attack and slide the pitch to the new note
  instead - the classic mono-synth behaviour. Releasing a key falls back to
  whichever key is still held (`[[ priority: last ]]`).
*/

import "fx/Distortion.ydsp" as dist;
import "fx/Compressor.ydsp" as comp;

declare name "Pulse Bass";
declare description "Monophonic pulse and sub through a resonant ladder, with legato phrasing and portamento.";

processor PulseVoice {
    output stream out;

    input value float width = 0.3 [[ name: "Pulse Width", min: 0.02, max: 0.98, smoothing: 0.02 ]];
    input value float sub = 0.6 [[ name: "Sub Level", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float cutoff = 220.0 [[ name: "Cutoff", min: 30.0, max: 4000.0 ]];
    input value float resonance = 0.6 [[ name: "Resonance", min: 0.0, max: 0.95, smoothing: 0.02 ]];
    input value float filterAmount = 9.0 [[ name: "Filter Amount", min: 0.0, max: 30.0 ]];
    input value float filterDecay = 0.18 [[ name: "Filter Decay", min: 0.005, max: 2.0, unit: "s" ]];
    input value float attack = 0.01 [[ name: "Attack", min: 0.001, max: 1.0, unit: "s" ]];
    input value float release = 0.3 [[ name: "Release", min: 0.02, max: 4.0, unit: "s" ]];
    input value float glide = 0.06 [[ name: "Glide", min: 0.001, max: 0.5, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase;
    state float subPhase;
    state float freq;
    state float freqTarget;
    state float glideCoeff;
    state float env;
    state float envTarget;
    state float envCoeff;

    state float fenv;
    state float fenvCoeff;

    state float z1;
    state float z2;
    state float z3;
    state float z4;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    func polyBlep (float t, float dt) : float {
        float r = 0.0;
        if (t < dt) {
            t = t / dt;
            r = t + t - t * t - 1.0;
        } else if (t > 1.0 - dt) {
            t = (t - 1.0) / dt;
            r = t * t + t + t + 1.0;
        }
        return r;
    }

    event noteOn (e) {
        freqTarget = noteToFreq (e.pitch);
        envTarget  = e.velocity;
        active     = 1;

        if (e.isLegato) {
            envCoeff   = 1.0 - exp (-1.0 / (0.005 * sampleRate));
            glideCoeff = 1.0 - exp (-1.0 / (glide * sampleRate));
        } else {
            envCoeff   = 1.0 - exp (-1.0 / (attack * sampleRate));
            glideCoeff = 1.0;

            fenv      = 1.0;
            fenvCoeff = pow (0.001, 1.0 / (filterDecay * sampleRate));

            bendFactor = 1.0;
            vibratoPhase = 0.0;
        }
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    event noteOff (e) {
        envTarget = 0.0;
        envCoeff  = 1.0 - exp (-1.0 / (release * sampleRate));
    }

    process {
        freq = freq + (freqTarget - freq) * glideCoeff;

        env = env + (envTarget - env) * envCoeff;

        fenv = fenv * fenvCoeff;

        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float dt = freq * pitchFactor * samplePeriod;

        phase = phase + dt;
        if (phase >= 1.0) { phase = phase - 1.0; }

        float falling = phase < width ? phase - width + 1.0 : phase - width;
        float pulse = (phase < width ? 1.0 : -1.0)
                    + polyBlep (phase, dt)
                    - polyBlep (falling, dt);

        float dtSub = dt * 0.5;

        subPhase = subPhase + dtSub;
        if (subPhase >= 1.0) { subPhase = subPhase - 1.0; }

        float subFalling = subPhase < 0.5 ? subPhase + 0.5 : subPhase - 0.5;
        float square = (subPhase < 0.5 ? 1.0 : -1.0)
                     + polyBlep (subPhase, dtSub)
                     - polyBlep (subFalling, dtSub);

        float mix = pulse * (1.0 - 0.5 * sub) + square * sub;

        float k = clamp (smooth (1.0 - exp (-2.0 * pi * cutoff * samplePeriod), 0.02)
                             * (1.0 + filterAmount * fenv),
                         0.0005,
                         0.98);

        float driven = mix - resonance * 4.0 * (z4 - 0.5 * mix);

        z1 = z1 + k * (tanh (driven) - z1);
        z2 = z2 + k * (z1 - z2);
        z3 = z3 + k * (z2 - z3);
        z4 = z4 + k * (z3 - z4);

        active = select (abs (env) < 0.000001, 0, 1);

        out = z4 * env * 1.6;
    }
}

graph PulseBass {
    input event midi;
    output stream out;

    node voices = PulseVoice [[ mode: mono, priority: last ]];
    node drive = dist.Distortion (drive = 0.0, tone = 0.35, mix = 0.4);
    node compressor = comp.Compressor (threshold = -20.0, ratio = 3.0, attack = 0.005, release = 0.15, makeup = 1.5);

    connection {
        voices.out -> drive.in;
        drive.out -> compressor.in;
        compressor.out -> out;
    }
}
/*
  The oscillator bench: six sources behind one selector, an organ-style gate
  envelope that holds while the key is down, and no effect at all - the patch is
  deliberately dry so what you hear is the oscillator and nothing else.

  - saw       (0): naive ramp minus the polyBLEP residual at the phase wrap.
  - square    (1): a pulse at `width` - rise at the wrap, fall at `width`.
  - triangle  (2): a naive ramp pair whose four corners are rounded by the exact
              antiderivative of the two edge residuals.
  - pulse     (3): the same pulse generator as the square, morphed by `width`
              (a square *is* a pulse at 50% width, so the two positions exist to
              A/B the default against a width-morphed one).
  - noise     (4): a hand-rolled linear congruential generator. There is no RNG
              intrinsic in the language, but `state int` plus the bitwise
              operators are enough to write one.
  - supersaw  (5): three polyBLEP saws detuned around the note.
*/

declare name "Wave Lab";
declare description "Six band-limited oscillators behind one selector, dry, with a peak meter.";

processor WaveLabVoice {
    output stream out;

    input value float wave = 5.0 [[ name: "Waveform", min: 0.0, max: 5.0,
                                    values: { "Saw", "Square", "Triangle", "Pulse", "Noise", "Supersaw" } ]];

    input value float width = 0.5 [[ name: "Pulse Width", min: 0.02, max: 0.98, smoothing: 0.02 ]];
    input value float detune = 14.0 [[ name: "Supersaw Detune", min: 0.0, max: 40.0, unit: "cents" ]];
    input value float cutoff = 4000.0 [[ name: "Cutoff", min: 60.0, max: 12000.0 ]];
    input value float release = 0.06 [[ name: "Release", min: 0.01, max: 1.0, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event programChange;
    input event pitchBend;
    input event control;

    state float bendFactor = 1.0;
    state float modWheel;
    state float vibratoPhase;

    state float phase;
    state float phaseB;
    state float phaseC;
    state float freq;
    state float z1;

    state float env;
    state float level;
    state float attackCoeff;
    state float releaseCoeff;
    state int released;

    state int rng;

    state int progWave;
    state int progSet;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    func polyBlep (float t, float dt) : float {
        float r = 0.0;
        if (t < dt) {
            t = t / dt;
            r = t + t - t * t - 1.0;
        } else if (t > 1.0 - dt) {
            t = (t - 1.0) / dt;
            r = t * t + t + t + 1.0;
        }
        return r;
    }

    func blepInt (float x, float dt) : float {
        float u = x - 1.0 + dt;
        float r = select (x < dt, x * x / dt - x * x * x / (3.0 * dt * dt) - x, -dt / 3.0);
        r = select (x > 1.0 - dt, -dt / 3.0 + u * u * u / (3.0 * dt * dt), r);
        return select (x > 1.0, 0.0, r);
    }

    event noteOn (e) {
        freq  = noteToFreq (e.pitch);
        level = e.velocity;

        attackCoeff = 1.0 - exp (-1.0 / (0.002 * sampleRate));
        released    = 0;
        active      = 1;

        rng = rng ^ (int (e.pitch) * 1103515245);

        bendFactor = 1.0;
        vibratoPhase = 0.0;
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released     = 1;
    }

    event programChange (e) {
        progWave = e.program % 6;
        progSet  = 1;
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    process {
        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
                          * (1.0 + 0.02888113 * smooth (modWheel, 0.05) * sin (vibratoPhase * 2.0 * pi));

        float dt = freq * pitchFactor * samplePeriod;
        float ratio = pow (2.0, detune / 1200.0);
        float dtB = dt * ratio;
        float dtC = dt / ratio;

        phase = phase + dt;
        if (phase >= 1.0) { phase = phase - 1.0; }
        phaseB = phaseB + dtB;
        if (phaseB >= 1.0) { phaseB = phaseB - 1.0; }
        phaseC = phaseC + dtC;
        if (phaseC >= 1.0) { phaseC = phaseC - 1.0; }

        float osc = 0.0;
        float falling = phase < width ? phase - width + 1.0 : phase - width;

        float sel = select (progSet != 0, float (progWave), wave);
        if (sel < 0.5) {
            float saw = 2.0 * phase - 1.0 - polyBlep (phase, dt);
            osc = saw;
        } else if (sel < 1.5) {
            float square = (phase < width ? 1.0 : -1.0)
                         + polyBlep (phase, dt)
                         - polyBlep (falling, dt);
            osc = square;
        } else if (sel < 2.5) {
            float triCorr = blepInt (phase, dt)
                          - (select (phase < 0.5, blepInt (phase + 0.5, dt), blepInt (phase - 0.5, dt)) + dt / 3.0);
            float tri = select (phase < 0.5, 1.0 - 4.0 * phase, 4.0 * phase - 3.0) - 4.0 * triCorr;
            osc = tri;
        } else if (sel < 3.5) {
            float pulse = (phase < width ? 1.0 : -1.0)
                        + polyBlep (phase, dt)
                        - polyBlep (falling, dt);
            osc = pulse;
        } else if (sel < 4.5) {
            float noise = float (rng >> 8) * 1.1920929e-7;
            osc = noise;
        } else {
            float sawA = 2.0 * phase - 1.0 - polyBlep (phase, dt);
            float sawB = 2.0 * phaseB - 1.0 - polyBlep (phaseB, dtB);
            float sawC = 2.0 * phaseC - 1.0 - polyBlep (phaseC, dtC);
            float supersaw = (sawA + sawB + sawC) * 0.4;
            osc = supersaw;
        }

        rng = rng * 1664525 + 1013904223;

        float k = smooth (1.0 - exp (-2.0 * pi * cutoff * samplePeriod), 0.02);
        z1 = z1 + k * (osc - z1);

        if (released > 0) {
            env = env * releaseCoeff;
        } else {
            env = env + (level - env) * attackCoeff;
        }

        active = select (env < 0.000001, 0, 1);

        out = z1 * env;
    }
}

processor OutputStage {
    input stream in;
    output stream out;

    input value float level = 0.8 [[ name: "Output", min: 0.0, max: 1.5, smoothing: 0.02 ]];

    output value float peak;

    state float held;

    process {
        float y = in * level;

        float mag = abs (y);
        held = select (mag > held, mag, held * 0.9999);

        peak = held;
        out = y;
    }
}

graph WaveLab {
    input event midi;
    output stream out;

    output value float peak;

    node voices = WaveLabVoice[6];
    node stage = OutputStage;

    connection {
        voices.out -> stage.in;
        stage.out -> out;

        stage.peak -> peak;
    }
}
/*
  A hard-sync lead through a ring modulator, and the demo's `control` (MIDI CC)
  example.

  Sync is two oscillators where the second is locked to the first. Here the slave
  is a pure function of the master's phase - `frac(phase * ratio)` - so it runs
  `ratio` cycles for every one of the master's, and the whole thing is windowed
  by the master's own cycle. Sweeping `ratio` moves a formant-like peak that
  stays locked to the note's pitch, which is the sound the patch exists for.
*/

import "fx/Chorus.ydsp" as fx;

declare name "Wobble Lead";
declare description "Hard-sync saw through a ring modulator, swept by an LFO under mod-wheel control.";

processor WobbleVoice {
    output stream out;

    input value float syncMin = 1.0 [[ name: "Sync Min", min: 1.0, max: 6.0 ]];
    input value float syncMax = 5.5 [[ name: "Sync Max", min: 1.0, max: 14.0 ]];
    input value float lfoRate = 3.2 [[ name: "LFO Rate", min: 0.05, max: 20.0, unit: "Hz" ]];

    input value float ring = 0.45 [[ name: "Ring Mod", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float ringRatio = 1.5 [[ name: "Ring Ratio", min: 0.25, max: 8.0 ]];

    input value float highpass = 160.0 [[ name: "Highpass", min: 20.0, max: 2000.0 ]];

    input value float attack = 0.006 [[ name: "Attack", min: 0.001, max: 0.5, unit: "s" ]];
    input value float release = 0.25 [[ name: "Release", min: 0.02, max: 3.0, unit: "s" ]];

    input event noteOn;
    input event noteOff;
    input event control;
    input event pitchBend;

    state float bendFactor = 1.0;
    state float vibratoPhase;

    state float phase;
    state float ringPhase;
    state float lfoPhase;
    state float freq;
    state float hp;

    state float env;
    state float level;
    state float attackRate;
    state float releaseCoeff;
    state int released;

    state float modWheel;

    state int active [[ role: voiceActivity ]];

    func noteToFreq (float pitch) : float {
        return 440.0 * pow (2.0, (pitch - 69.0) / 12.0);
    }

    func polyBlep (float t, float dt) : float {
        float r = 0.0;
        if (t < dt) {
            t = t / dt;
            r = t + t - t * t - 1.0;
        } else if (t > 1.0 - dt) {
            t = (t - 1.0) / dt;
            r = t * t + t + t + 1.0;
        }
        return r;
    }

    event noteOn (e) {
        freq         = noteToFreq (e.pitch);
        level        = e.velocity;
        attackRate   = e.velocity / (attack * sampleRate);
        released     = 0;
        active       = 1;
        bendFactor   = 1.0;
        vibratoPhase = 0.0;
    }

    event noteOff (e) {
        releaseCoeff = pow (0.001, 1.0 / (release * sampleRate));
        released     = 1;
    }

    event control (e) {
        if (e.control == 1) { modWheel = e.value; }
    }

    event pitchBend (e) {
        bendFactor = pow (2.0, e.bendSemitones / 12.0);
    }

    process {
        float depth = smooth (modWheel, 0.05);

        vibratoPhase = vibratoPhase + 5.5 * samplePeriod;
        vibratoPhase = vibratoPhase - floor (vibratoPhase);

        float pitchFactor = bendFactor
            * (1.0 + 0.02888113 * depth * sin (vibratoPhase * 2.0 * pi));

        float dt = freq * pitchFactor * samplePeriod;

        phase = phase + dt;
        if (phase >= 1.0) { phase = phase - 1.0; }

        lfoPhase = lfoPhase + lfoRate * samplePeriod;
        if (lfoPhase >= 1.0) { lfoPhase = lfoPhase - 1.0; }
        float lfo = 0.5 + 0.5 * sin (lfoPhase * 2.0 * pi);
        float ratio = syncMin + (syncMax - syncMin) * lfo * depth;

        float slave = phase * ratio;
        float slavePhase = slave - floor (slave);
        float dtSlave = dt * ratio;

        float slaveSaw = 2.0 * slavePhase - 1.0 - polyBlep (slavePhase, dtSlave);
        float window = 0.5 - 0.5 * cos (phase * 2.0 * pi);

        float saw = slaveSaw * window;

        ringPhase = ringPhase + dt * ringRatio;
        ringPhase = ringPhase - floor (ringPhase);

        float modulator = sin (ringPhase * 2.0 * pi);
        float y = saw * (1.0 - ring + ring * modulator);

        float k = smooth (1.0 - exp (-2.0 * pi * highpass * samplePeriod), 0.02);
        hp = hp + k * (y - hp);

        if (released > 0) {
            env = env * releaseCoeff;
        } else {
            env = env + attackRate;
            if (env >= level) { env = level; }
        }

        active = select (env < 0.000001, 0, 1);

        out = (y - hp) * env * 0.7;
    }
}

graph WobbleLead {
    input event midi;
    output stream out;

    node voices = WobbleVoice[6] [[ mode: poly, stealing: oldest ]];
    node chorus = fx.Chorus (rate = 1.2, depth = 0.005, mix = 0.5);

    connection {
        voices.out -> chorus.in;
        chorus.out -> out;
    }
}
/*
  A chorus built from a modulated delay line: a sine LFO sweeps the read
  position around a ~20 ms base delay and the delayed signal is mixed with the
  dry signal.
*/

processor Chorus {
    input stream in;
    output stream out;

    input value float rate = 1.5 [[ name: "Rate", min: 0.05, max: 8.0, unit: "Hz" ]];
    input value float depth = 0.004 [[ name: "Depth", min: 0.0, max: 0.02, unit: "s", smoothing: 0.02 ]];
    input value float mix = 0.5 [[ name: "Mix", min: 0.0, max: 1.0, smoothing: 0.02 ]];

    state float buf[4096];
    state int wp;
    state float lfoPhase;

    process {
        buf[wp] = in;
        wp = wp + 1;
        if (wp >= 4096) { wp = 0; }

        lfoPhase = lfoPhase + rate / sampleRate;
        if (lfoPhase >= 1.0) { lfoPhase = lfoPhase - 1.0; }

        float lfo = sin (lfoPhase * 6.283185307);
        float delaySamples = clamp (0.02 * sampleRate + depth * sampleRate * lfo, 0.0, 4000.0);

        int readIdx = wp - int (delaySamples);
        if (readIdx < 0) { readIdx = readIdx + 4096; }

        out = (1.0 - mix) * in + mix * buf[readIdx];
    }
}
/*
  A feedforward compressor: peak envelope follower with separate attack and
  release rates, a hard-knee gain computer, and makeup gain.
*/

processor Compressor {
    input stream in;
    output stream out;

    input value float threshold = -18.0 [[ name: "Threshold", min: -60.0, max: 0.0, unit: "dB", smoothing: 0.02 ]];
    input value float ratio = 4.0 [[ name: "Ratio", min: 1.0, max: 20.0, smoothing: 0.02 ]];
    input value float attack = 0.005 [[ name: "Attack", min: 0.001, max: 0.1, unit: "s" ]];
    input value float release = 0.15 [[ name: "Release", min: 0.01, max: 1.0, unit: "s" ]];
    input value float makeup = 1.0 [[ name: "Makeup", min: 1.0, max: 4.0, smoothing: 0.02 ]];

    state float env;

    process {
        float attackCoeff = 1.0 - exp (-1.0 / (attack * sampleRate));
        float releaseCoeff = 1.0 - exp (-1.0 / (release * sampleRate));

        float level = abs (in);
        float coeff = level > env ? attackCoeff : releaseCoeff;
        env = env + coeff * (level - env);

        float envDb = 20.0 * log10 (env + 1e-6);
        float gainDb = 0.0;
        if (envDb > threshold) { gainDb = (threshold - envDb) * (1.0 - 1.0 / ratio); }

        float gain = pow (10.0, gainDb / 20.0);
        out = in * gain * makeup;
    }
}
/*
  A feedback delay with a one-pole lowpass (damping) in the feedback path and
  a dry/wet mix.
*/

processor Delay {
    input stream in;
    output stream out;

    input value float time = 0.375 [[ name: "Delay Time", min: 0.01, max: 2.0, unit: "s" ]];
    input value float feedback = 0.4 [[ name: "Feedback", min: 0.0, max: 0.95, smoothing: 0.02 ]];
    input value float damping = 0.5 [[ name: "Damping", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float mix = 0.35 [[ name: "Mix", min: 0.0, max: 1.0, smoothing: 0.02 ]];

    state float buf[96000];
    state int wp;
    state float damped;

    process {
        int delaySamples = int (time * sampleRate);
        if (delaySamples > 96000) { delaySamples = 96000; }

        float delayed = 0.0;
        if (delaySamples > 0) {
            int readIdx = wp - delaySamples;
            if (readIdx < 0) { readIdx = readIdx + 96000; }
            delayed = buf[readIdx];
        }

        damped = damped * damping + delayed * (1.0 - damping);

        buf[wp] = in + feedback * damped;
        wp = wp + 1;
        if (wp >= 96000) { wp = 0; }

        out = (1.0 - mix) * in + mix * delayed;
    }
}
/*
  A tanh waveshaper distortion with a one-pole lowpass tone control and a
  parallel dry/wet mix.
*/

processor Distortion {
    input stream in;
    output stream out;

    input value float drive = 1.0 [[ name: "Drive", min: 1.0, max: 20.0, smoothing: 0.02 ]];
    input value float tone = 0.5 [[ name: "Tone", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float mix = 0.7 [[ name: "Mix", min: 0.0, max: 1.0, smoothing: 0.02 ]];

    state float z1;

    process {
        float shaped = tanh (in * drive);

        float k = 0.05 + 0.95 * tone;
        z1 = z1 + k * (shaped - z1);

        out = in + mix * (z1 - in);
    }
}
/*
  A reusable master bus: a compressor, then a reverb blended against a parallel
  dry path.

  This is a `graph`, not a `processor`, so it can only be used as a node inside
  another graph - the compiler inlines it away and the runtime only ever sees
  the processors it contains. Its own parameters forward to the inner nodes, so
  a patch can set `threshold` here without knowing which processor ends up
  owning it.

  The dry/wet is expressed in the *graph*: `compressor.out` fans out to a dry
  trim and to the reverb, and both branches are summed back into `out`. The
  reverb therefore runs fully wet (`mix = 1.0`) and `reverbMix` is a real
  graph-level balance rather than a value forwarded into one processor's own
  internal mix. That is what lets `Reverb` stay a reverb instead of also being
  a mixer, and it is the shape every effect in `fx/` would use if it were
  written today.
*/

import "Compressor.ydsp" as comp;
import "Reverb.ydsp" as verb;

processor DryWetLevel {
    input stream dry;
    input stream wet;
    output stream out;

    input value float mix = 0.25 [[ name: "Dry/Wet", smoothing: 0.02 ]];

    process { out = dry * (1.0 - mix) + wet * mix; }
}

    graph MasterBus {
    input stream in;
    output stream out;

    input value float threshold = -18.0 [[ name: "Threshold", min: -60.0, max: 0.0, unit: "dB" ]];
    input value float ratio = 4.0 [[ name: "Ratio", min: 1.0, max: 20.0 ]];
    input value float reverbMix = 0.25 [[ name: "Reverb Mix", min: 0.0, max: 1.0 ]];
    input value float roomSize = 0.7 [[ name: "Room Size", min: 0.0, max: 1.0 ]];

    node compressor = comp.Compressor (attack = 0.005, release = 0.12, makeup = 1.2);
    node reverb = verb.Reverb (damping = 0.5, mix = 1.0);
    node dryWet = DryWetLevel;

    connection {
        in -> compressor.in;

        compressor.out -> dryWet.dry;
        compressor.out -> reverb.in;

        reverb.out -> dryWet.wet;

        dryWet.out -> out;

        threshold -> compressor.threshold;
        ratio -> compressor.ratio;
        roomSize -> reverb.roomSize;
        reverbMix -> dryWet.mix;
    }
}
/*
  A Freeverb-style Schroeder reverb: eight parallel comb filters with per-comb
  one-pole damping, followed by four series allpass diffusers. Ported from the
  Freeverb code; each '@' delay primitive owns its own ring buffer.
*/

processor Reverb {
    input stream in;
    output stream out;

    input value float mix = 0.33 [[ name: "Mix", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float damping = 0.5 [[ name: "Damping", min: 0.0, max: 1.0, smoothing: 0.02 ]];
    input value float roomSize = 0.8 [[ name: "Room Size", min: 0.0, max: 1.0, smoothing: 0.02 ]];

    state float c1;
    state float c2;
    state float c3;
    state float c4;
    state float c5;
    state float c6;
    state float c7;
    state float c8;

    state float last1;
    state float last2;
    state float last3;
    state float last4;
    state float last5;
    state float last6;
    state float last7;
    state float last8;

    state float a1;
    state float a2;
    state float a3;
    state float a4;

    process {
        float feedback = roomSize * 0.28 + 0.7;
        float gain = 0.015;

        let d1 = c1 @ 1116;
        last1 = last1 * damping + d1 * (1.0 - damping);
        c1 = last1 * feedback + gain * in;

        let d2 = c2 @ 1188;
        last2 = last2 * damping + d2 * (1.0 - damping);
        c2 = last2 * feedback + gain * in;

        let d3 = c3 @ 1277;
        last3 = last3 * damping + d3 * (1.0 - damping);
        c3 = last3 * feedback + gain * in;

        let d4 = c4 @ 1356;
        last4 = last4 * damping + d4 * (1.0 - damping);
        c4 = last4 * feedback + gain * in;

        let d5 = c5 @ 1422;
        last5 = last5 * damping + d5 * (1.0 - damping);
        c5 = last5 * feedback + gain * in;

        let d6 = c6 @ 1491;
        last6 = last6 * damping + d6 * (1.0 - damping);
        c6 = last6 * feedback + gain * in;

        let d7 = c7 @ 1557;
        last7 = last7 * damping + d7 * (1.0 - damping);
        c7 = last7 * feedback + gain * in;

        let d8 = c8 @ 1617;
        last8 = last8 * damping + d8 * (1.0 - damping);
        c8 = last8 * feedback + gain * in;

        let wet = d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8;

        let e1 = a1 @ 225;
        a1 = wet + e1 * 0.5;
        let ap1 = e1 - wet;

        let e2 = a2 @ 341;
        a2 = ap1 + e2 * 0.5;
        let ap2 = e2 - ap1;

        let e3 = a3 @ 441;
        a3 = ap2 + e3 * 0.5;
        let ap3 = e3 - ap2;

        let e4 = a4 @ 556;
        a4 = ap3 + e4 * 0.5;
        let ap4 = e4 - ap3;

        out = (1.0 - mix) * in + mix * ap4;
    }
}
